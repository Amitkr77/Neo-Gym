# Copy to backend/.env and fill in real values. Never commit .env.

# Port the API listens on. The admin and frontend apps default to http://localhost:7002.
PORT=7002

# MongoDB connection string
CONNECTION_STRING=mongodb://127.0.0.1:27017/neogym

# Long random secret used to sign login tokens (at least 32 characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token lifetimes (jsonwebtoken format, e.g. 1h, 8h, 7d)
JWT_EXPIRY=1h
ADMIN_JWT_EXPIRY=8h

# Comma-separated list of browser origins allowed to call the API (both UIs).
# Leave empty only for local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Set to true when running behind a reverse proxy (so rate limiting sees real client IPs).
TRUST_PROXY=false

# Optional rate limits (requests per window per IP)
LOGIN_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=20
CONTACT_RATE_LIMIT=10
